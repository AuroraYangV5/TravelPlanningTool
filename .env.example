# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DOUBAO_API_KEY: Required for Doubao AI API calls.
DOUBAO_API_KEY="MY_DOUBAO_API_KEY"
# DOUBAO_MODEL_ID: The endpoint ID for the Doubao model.
DOUBAO_MODEL_ID="MY_DOUBAO_MODEL_ID"
# DOUBAO_BASE_URL: The base URL for the Doubao API.
DOUBAO_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"

# QWEN_API_KEY: Required for Qwen (DashScope) AI API calls.
QWEN_API_KEY="MY_QWEN_API_KEY"
# QWEN_MODEL_ID: The model name for Qwen (e.g., qwen-max, qwen-plus).
QWEN_MODEL_ID="qwen-max"
# QWEN_BASE_URL: The base URL for the Qwen API.
QWEN_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
